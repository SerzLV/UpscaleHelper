<Window x:Class="UpscaleHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="UpscaleHelper" Icon="Assets/UpscaleHelper.ico"
        Width="1192" Height="820" MinWidth="920" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CompareFilesCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Geometry x:Key="ExpandIcon">M2,8 L2,2 8,2 M14,2 L20,2 20,8 M20,14 L20,20 14,20 M8,20 L2,20 2,14 M7,15 L15,7 M10,7 L15,7 15,12</Geometry>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ModelChoice" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceRow}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="#151824">
            <DockPanel Margin="25,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#342758" CornerRadius="9">
                        <Path Data="{StaticResource ExpandIcon}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="UpscaleHelper" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox DockPanel.Dock="Right" Width="73" MinHeight="32" Margin="9,0,0,0" VerticalAlignment="Center"
                          SelectedIndex="{Binding LanguageIndex}" IsEnabled="{Binding CanEdit}"
                          ToolTip="{DynamicResource Language}" AutomationProperties.Name="{DynamicResource Language}">
                    <ComboBoxItem Content="RU"/>
                    <ComboBoxItem Content="EN"/>
                </ComboBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="25,19,25,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,17">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StudioEyebrow}" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{DynamicResource PhotosAndVideos}" FontSize="37" FontWeight="SemiBold" Margin="0,2,0,1"/>
                    <TextBlock Text="{DynamicResource MainSubtitle}" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource StudioButton}" Content="{DynamicResource CompareFiles}" Padding="14,9" Margin="0,0,8,0"
                            Command="{Binding CompareFilesCommand}" ToolTip="{DynamicResource CompareFilesTip}"/>
                    <Button Style="{StaticResource StudioButton}" Command="{Binding AddCommand}"
                            ToolTip="{DynamicResource AddFilesTip}" Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,7 H13 M7,1 V13" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource AddFiles}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="322"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="190"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="2*" MinHeight="135"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <p:ComparisonView DataContext="{Binding Comparison}"/>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,11">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Remove}" Style="{StaticResource StudioButton}"
                                        Command="{Binding RemoveCommand}" ToolTip="{DynamicResource RemoveTip}"
                                        Padding="10,4" MinHeight="28"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Queue}" FontSize="17" FontWeight="SemiBold"/>
                                    <Border Background="#302748" CornerRadius="6" Margin="8,0,0,0" Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Eyebrow}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Border Background="{StaticResource InsetBrush}" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DropFiles}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource FileTypesHint}" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="QueueList" Style="{StaticResource FlatList}" ItemsSource="{Binding Items}"
                                         ItemContainerStyle="{StaticResource SelectableRow}" SelectedItem="{Binding Selected}"
                                         Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}}"
                                         AutomationProperties.Name="{DynamicResource FileQueue}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type p:QueueItem}">
                                            <Grid MinHeight="29">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}"/>
                                                                        <Setter Property="ToolTip" Value="{DynamicResource ElapsedTip}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="#FF9DAB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Content="{DynamicResource CompareResult}" ToolTip="{DynamicResource CompareResultTip}"
                                                            Command="{Binding DataContext.CompareFilesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Kind}" Value="Video"/>
                                                                            <Condition Binding="{Binding State}" Value="Completed"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{DynamicResource Reveal}" ToolTip="{DynamicResource RevealTip}"
                                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Completed">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{DynamicResource Details}" Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{DynamicResource Retry}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Canceled"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0}%, TargetNullValue=—}"
                                                                   Style="{StaticResource Eyebrow}" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Progress}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ProgressBar Grid.Row="1" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Height="4"
                                                                 Foreground="{StaticResource PrimaryBrush}" Background="#2B2D40"
                                                                 AutomationProperties.Name="{DynamicResource FileProgress}"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource StudioButton}" Content="{DynamicResource PreviewClip}" Command="{Binding PreviewCommand}"
                                    Visibility="{Binding CanPreviewVideo, Converter={StaticResource VisibleWhen}}"
                                    Margin="0,0,0,7" ToolTip="{DynamicResource PreviewClipTip}"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Content="{Binding StartLabel}"
                                    ToolTip="{DynamicResource StartTip}"/>
                            <Button Style="{StaticResource StudioButton}" Command="{Binding CancelCommand}" Margin="0,7,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" Content="{DynamicResource CancelProcessing}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                <StackPanel IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="{DynamicResource ScaleHeading}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                                    <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ScaleIndex}" AutomationProperties.Name="{DynamicResource Scale}">
                                        <ListBoxItem Style="{StaticResource ChoiceRow}" Content="2×"/>
                                        <ListBoxItem Style="{StaticResource ChoiceRow}" Content="4×" Margin="0"
                                                     IsEnabled="{Binding CanUseFourTimes}" ToolTipService.ShowOnDisabled="True"
                                                     ToolTip="{DynamicResource ScaleFourTip}"/>
                                    </ListBox>
                                    <TextBlock Text="{DynamicResource ModelHeading}" Style="{StaticResource Eyebrow}" Margin="0,15,0,6"/>
                                    <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ModelIndex}" AutomationProperties.Name="{DynamicResource UpscaleModel}">
                                        <ListBoxItem Style="{StaticResource ModelChoice}" Content="{DynamicResource DetailMode}"/>
                                        <ListBoxItem Style="{StaticResource ModelChoice}" Content="{DynamicResource FastMode}"/>
                                        <ListBoxItem Style="{StaticResource ModelChoice}" Content="{DynamicResource AnimationMode}" Margin="0"/>
                                    </ListBox>
                                    <TextBlock Text="{Binding ModelHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource SaveHeading}" Style="{StaticResource Eyebrow}" Margin="0,15,0,6"/>
                                    <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="9,8">
                                        <TextBlock Text="{Binding FolderLabel}" ToolTip="{Binding FolderLabel}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource StudioButton}" Content="{DynamicResource ChooseFolder}" Command="{Binding FolderCommand}" MinHeight="29" Padding="8,4"/>
                                        <Button Style="{StaticResource StudioButton}" Content="{DynamicResource Reset}" Command="{Binding ResetFolderCommand}"
                                                MinHeight="29" Padding="8,4" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource RemoveAudio}" IsChecked="{Binding RemoveAudio}" Margin="0,9,0,0"
                                              Foreground="{StaticResource TextBrush}" ToolTip="{DynamicResource RemoveAudioTip}"
                                              Visibility="{Binding HasVideos, Converter={StaticResource VisibleWhen}}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource OutputFormats}" Style="{StaticResource MutedText}" Margin="0,13,0,0"/>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#151824">
            <DockPanel Margin="25,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsComparisonRunning, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Metrics}" VerticalAlignment="Center" Style="{StaticResource Eyebrow}" Margin="0,0,14,0"/>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                 Width="135" Height="5" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Background="#2B2D40"
                                 AutomationProperties.Name="{DynamicResource ComparisonProgress}"/>
                    <TextBlock Text="{Binding ProgressLabel}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Eyebrow}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
