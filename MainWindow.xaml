<Window x:Class="UpscaleHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="UpscaleHelper" Icon="Assets/UpscaleHelper.ico"
        Width="1192" Height="820" MinWidth="920" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CompareFilesCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Geometry x:Key="ExpandIcon">M2,8 L2,2 8,2 M14,2 L20,2 20,8 M20,14 L20,20 14,20 M8,20 L2,20 2,14 M7,15 L15,7 M10,7 L15,7 15,12</Geometry>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PhotoRowAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CanvasButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <DataTemplate x:Key="UpscaleBar">
            <Grid>
                <Expander Style="{StaticResource CanvasExpander}" Header="{DynamicResource RestorationAdvanced}" Margin="0,1,0,0"
                          Foreground="{StaticResource MutedBrush}" IsEnabled="{Binding CanEdit}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="113" Margin="0,7,0,0">
                        <WrapPanel>
                            <StackPanel Width="152" Margin="0,0,12,7">
                                <TextBlock Text="{DynamicResource UpscaleModel}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding ModelIndex}" MinHeight="31" ToolTip="{Binding ModelHint}"
                                          AutomationProperties.Name="{DynamicResource UpscaleModel}">
                                    <ComboBoxItem Content="{DynamicResource DetailMode}"/>
                                    <ComboBoxItem Content="{DynamicResource FastMode}"/>
                                    <ComboBoxItem Content="{DynamicResource AnimationMode}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="222" Margin="0,0,12,7">
                                <TextBlock Text="{Binding FolderLabel}" ToolTip="{Binding FolderLabel}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StudioButton}" Content="{DynamicResource ChooseFolder}"
                                            Command="{Binding FolderCommand}" MinHeight="31" Padding="8,4"/>
                                    <Button Style="{StaticResource StudioButton}" Content="{DynamicResource Reset}"
                                            Command="{Binding ResetFolderCommand}" MinHeight="31" Padding="8,4" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Width="184" Margin="0,0,12,7" Visibility="{Binding HasVideos, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{DynamicResource VideoQualityHeading}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding VideoQualityIndex}" MinHeight="31" AutomationProperties.Name="{DynamicResource VideoQualityHeading}">
                                    <ComboBoxItem Content="{DynamicResource VideoQualityCompact}"/>
                                    <ComboBoxItem Content="{DynamicResource VideoQualityBalanced}"/>
                                    <ComboBoxItem Content="{DynamicResource VideoQualityHigh}"/>
                                </ComboBox>
                                <CheckBox Content="{DynamicResource RemoveAudio}" IsChecked="{Binding RemoveAudio}" Margin="0,6,0,0"
                                          Foreground="{StaticResource TextBrush}" ToolTip="{DynamicResource RemoveAudioTip}"/>
                            </StackPanel>
                        </WrapPanel>
                    </ScrollViewer>
                </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="67" MinHeight="34" Margin="0,0,8,0" SelectedIndex="{Binding ScaleIndex}"
                              IsEnabled="{Binding CanEdit}" ToolTip="{DynamicResource Scale}" AutomationProperties.Name="{DynamicResource Scale}">
                        <ComboBoxItem Content="2×"/>
                        <ComboBoxItem Content="4×" IsEnabled="{Binding CanUseFourTimes}" ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{DynamicResource ScaleFourTip}"/>
                    </ComboBox>
                    <Button Style="{StaticResource StudioButton}" Content="{DynamicResource PreviewClip}" Command="{Binding PreviewCommand}"
                            Visibility="{Binding CanPreviewVideo, Converter={StaticResource VisibleWhen}}"
                            ToolTip="{DynamicResource PreviewClipTip}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CanvasButton}" Content="{Binding StartLabel}" Command="{Binding StartCommand}"
                            ToolTip="{DynamicResource StartTip}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="175"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="18,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource StudioButton}" Command="{Binding AddCommand}"
                            ToolTip="{DynamicResource AddFilesTip}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,7 H13 M7,1 V13" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource AddFiles}"/>
                        </StackPanel>
                    </Button>
                    <ComboBox Width="70" MinHeight="32" VerticalAlignment="Center" SelectedIndex="{Binding LanguageIndex}"
                              IsEnabled="{Binding CanEdit}" ToolTip="{DynamicResource Language}" AutomationProperties.Name="{DynamicResource Language}">
                        <ComboBoxItem Content="RU"/>
                        <ComboBoxItem Content="EN"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#342758" CornerRadius="8">
                        <Path Data="{StaticResource ExpandIcon}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="UpscaleHelper" FontSize="17" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1" Margin="18,9,18,0">
            <Button Content="{DynamicResource RestorationStart}" Style="{StaticResource StudioButton}" Margin="0,0,8,0"
                    Command="{Binding RestorePhotoCommand}" ToolTip="{DynamicResource PickPhotoForTool}"/>
            <Button Content="{DynamicResource DrawDetails}" Style="{StaticResource StudioButton}" Margin="0,0,8,0"
                    Command="{Binding DrawDetailsCommand}" ToolTip="{DynamicResource PickPhotoForTool}"/>
            <Button Content="{DynamicResource CompressPhoto}" Style="{StaticResource StudioButton}" Margin="0,0,8,0"
                    Command="{Binding CompressPhotoCommand}" ToolTip="{DynamicResource PickPhotoForTool}"/>
            <Button Content="{DynamicResource CompareFiles}" Style="{StaticResource StudioButton}"
                    Command="{Binding CompareFilesCommand}" ToolTip="{DynamicResource CompareFilesTip}"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13" Margin="18,9,18,10">
            <Grid>
                <DockPanel Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Selected.Name}" ToolTip="{Binding Selected.Path}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                    <p:ComparisonView PreferWipe="True" DataContext="{Binding Comparison}"/>
                </DockPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource DropFiles}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource FileTypesHint}" Style="{StaticResource MutedText}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    <Button Content="{DynamicResource AddFiles}" Style="{StaticResource DialogPrimary}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Center" Margin="0,15,0,0" ToolTip="{DynamicResource AddFilesTip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="18,9" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UpscaleBar}"/>
        </Border>

        <Border Grid.Row="4" Padding="18,6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}}">
            <ListBox x:Name="QueueList" Style="{StaticResource FlatList}" ItemsSource="{Binding Items}" MaxHeight="110"
                     ItemContainerStyle="{StaticResource SelectableRow}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="{DynamicResource FileQueue}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type p:QueueItem}">
                            <Grid MinHeight="29">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}"/>
                                                        <Setter Property="ToolTip" Value="{DynamicResource ElapsedTip}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="#FF9DAB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{DynamicResource PhotoImproveShort}" Style="{StaticResource PhotoRowAction}"
                                            ToolTip="{DynamicResource PhotoImproveFromRow}"
                                            Command="{Binding DataContext.RestorePhotoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource PhotoDrawShort}" Style="{StaticResource PhotoRowAction}"
                                            ToolTip="{DynamicResource PhotoDrawFromRow}"
                                            Command="{Binding DataContext.DrawDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource CompressPhotoShort}" Style="{StaticResource PhotoRowAction}"
                                            ToolTip="{DynamicResource PhotoCompressFromRow}"
                                            Command="{Binding DataContext.CompressPhotoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource CompareResult}" ToolTip="{DynamicResource CompareResultTip}"
                                            Command="{Binding DataContext.CompareFilesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Reveal}" ToolTip="{DynamicResource RevealTip}"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Details}" Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Retry}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Canceled"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource QuietButton}" Width="28" MinHeight="26" Padding="0" Margin="7,0,0,0"
                                            ToolTip="{DynamicResource RemoveTip}" AutomationProperties.Name="{DynamicResource RemoveFromQueue}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"/>
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger></Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0}%, TargetNullValue=—}"
                                                   Style="{StaticResource Eyebrow}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Progress}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Height="4"
                                                 Foreground="{StaticResource PrimaryBrush}" Background="#2B2D40"
                                                 AutomationProperties.Name="{DynamicResource FileProgress}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="5" Padding="18,4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource StudioButton}" Command="{Binding CancelCommand}"
                        Content="{DynamicResource CancelProcessing}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
                        MinHeight="29" Padding="9,3" Margin="10,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                    <TextBlock MaxWidth="300" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Text" Value="{Binding ActiveItem.Progress}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComparisonRunning}" Value="True">
                                        <Setter Property="Text" Value="{Binding Metrics}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Width="124" Height="5" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"
                                 Background="#2B2D40" AutomationProperties.Name="{DynamicResource FileProgress}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Value" Value="{Binding ActiveItem.Percent, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/>
                                <Setter Property="IsIndeterminate" Value="{Binding ActiveItem.IsIndeterminate, FallbackValue=True}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComparisonRunning}" Value="True">
                                        <Setter Property="Value" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"/>
                                        <Setter Property="IsIndeterminate" Value="{Binding IsIndeterminate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
