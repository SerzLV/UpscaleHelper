<Window x:Class="UpscaleHelper.Presentation.JobErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProcessingError}" Width="590" Height="335" MinWidth="420" MinHeight="250"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Background="{StaticResource CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,12">
            <TextBlock Text="{DynamicResource ProcessingError}" Style="{StaticResource DialogHeading}"/>
            <TextBlock x:Name="FileLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="{DynamicResource Close}" Style="{StaticResource DialogButton}"
                    IsCancel="True" HorizontalAlignment="Right"/>
        </Border>
        <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource InsetBrush}" Foreground="{StaticResource TextBrush}" Padding="10" Margin="20,0,20,12"
                 AutomationProperties.Name="{DynamicResource ErrorDetails}"/>
    </DockPanel>
</Window>
