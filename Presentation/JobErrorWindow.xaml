<Window x:Class="UpscaleHelper.Presentation.JobErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProcessingError}" Width="590" Height="335" MinWidth="420" MinHeight="250"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource ProcessingError}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="FileLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="{DynamicResource Close}" Style="{StaticResource StudioButton}"
                IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
        <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource InsetBrush}" Foreground="{StaticResource TextBrush}" Padding="10"
                 AutomationProperties.Name="{DynamicResource ErrorDetails}"/>
    </DockPanel>
</Window>
