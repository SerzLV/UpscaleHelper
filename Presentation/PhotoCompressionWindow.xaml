<Window x:Class="UpscaleHelper.Presentation.PhotoCompressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="{DynamicResource CompressPhoto}" Width="1140" Height="750" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <DockPanel Background="{StaticResource CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,12">
            <TextBlock Text="{DynamicResource CompressPhoto}" Style="{StaticResource DialogHeading}"/>
            <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            <WrapPanel x:Name="Options" Margin="0,10,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource CompressionMode}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ModeBox" Width="216" MinHeight="34" SelectedIndex="0"
                              AutomationProperties.Name="{DynamicResource CompressionMode}" SelectionChanged="OnOptionsChanged">
                        <ComboBoxItem Content="{DynamicResource CompressionLossless}" ToolTip="{DynamicResource CompressionLosslessTip}"/>
                        <ComboBoxItem Content="{DynamicResource CompressionSmaller}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="QualityOptions" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource CompressionQuality}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Width="32" Padding="0" Style="{StaticResource StudioButton}" Click="OnQualityDown"
                                ToolTip="{DynamicResource CompressionQualityDown}" AutomationProperties.Name="{DynamicResource CompressionQualityDown}"/>
                        <TextBox x:Name="QualityBox" Width="47" MinHeight="32" Margin="4,0" Padding="4,0" MaxLength="3"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="OnOptionsChanged" PreviewKeyDown="OnQualityKey"
                                 ToolTip="{DynamicResource CompressionQualityRange}" AutomationProperties.Name="{DynamicResource CompressionQuality}"/>
                        <Button Content="+" Width="32" Padding="0" Style="{StaticResource StudioButton}" Click="OnQualityUp"
                                ToolTip="{DynamicResource CompressionQualityUp}" AutomationProperties.Name="{DynamicResource CompressionQualityUp}"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel>
                <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,9">
                    <TextBlock x:Name="StatusText" Text="{DynamicResource CompressionHint}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" Height="4" Margin="0,0,0,9"
                             Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="{DynamicResource CompressingPhoto}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0,0,8,0"/>
                    <Button x:Name="CancelButton" Content="{DynamicResource CancelProcessing}" Visibility="Collapsed"
                            Style="{StaticResource DialogButton}" Click="OnCancel"/>
                    <Button x:Name="PreviewButton" Content="{DynamicResource CompressionPreview}" Style="{StaticResource DialogPrimary}"
                            Click="OnPreview" IsDefault="True"/>
                    <Button x:Name="SaveButton" Content="{DynamicResource CompressionSave}" Style="{StaticResource DialogPrimary}"
                            IsEnabled="False" Visibility="Collapsed" Click="OnSave"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="13" Margin="20,0,20,12">
            <p:ComparisonView ShowOriginalFullWidth="True" PreferWipe="True"/>
        </Border>
    </DockPanel>
</Window>
