<Window x:Class="UpscaleHelper.Presentation.PhotoCompressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="{DynamicResource CompressPhoto}" Width="1120" Height="690" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource CompressPhoto}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            <WrapPanel x:Name="Options" Margin="0,10,0,0" VerticalAlignment="Center">
                <ComboBox x:Name="ModeBox" Width="198" MinHeight="32" Margin="0,0,9,0" SelectedIndex="0"
                          AutomationProperties.Name="{DynamicResource CompressionMode}" SelectionChanged="OnOptionsChanged">
                    <ComboBoxItem Content="{DynamicResource CompressionLossless}" ToolTip="{DynamicResource CompressionLosslessTip}"/>
                    <ComboBoxItem Content="{DynamicResource CompressionSmaller}"/>
                </ComboBox>
                <StackPanel x:Name="QualityOptions" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource CompressionQuality}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="−" Width="32" Padding="0" Style="{StaticResource StudioButton}" Click="OnQualityDown"
                            ToolTip="{DynamicResource CompressionQualityDown}" AutomationProperties.Name="{DynamicResource CompressionQualityDown}"/>
                    <TextBox x:Name="QualityBox" Width="47" MinHeight="32" Margin="4,0" Padding="4,0" MaxLength="3"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="OnOptionsChanged" PreviewKeyDown="OnQualityKey"
                             ToolTip="{DynamicResource CompressionQualityRange}" AutomationProperties.Name="{DynamicResource CompressionQuality}"/>
                    <Button Content="+" Width="32" Padding="0" Style="{StaticResource StudioButton}" Click="OnQualityUp"
                            ToolTip="{DynamicResource CompressionQualityUp}" AutomationProperties.Name="{DynamicResource CompressionQualityUp}"/>
                </StackPanel>
                <Button Content="{DynamicResource CompressionPreview}" Style="{StaticResource StudioButton}" Click="OnPreview" IsDefault="True"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="{DynamicResource CompressionHint}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,11,0,0">
            <Button Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource StudioButton}" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="{DynamicResource CompressionSave}" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="OnSave"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="14">
            <p:ComparisonView/>
        </Border>
    </DockPanel>
</Window>
