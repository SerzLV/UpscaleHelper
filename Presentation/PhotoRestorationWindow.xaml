<Window x:Class="UpscaleHelper.Presentation.PhotoRestorationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="{DynamicResource RestorePhoto}" Width="1120" Height="710" MinWidth="660" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource RestorePhoto}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            <Expander x:Name="AdvancedOptions" Header="{DynamicResource RestorationAdvanced}" Foreground="{StaticResource TextBrush}"
                      Margin="0,9,0,0">
              <WrapPanel x:Name="Options" Margin="0,7,0,0">
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{DynamicResource RestorationMode}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ModeBox" Width="176" MinHeight="32" SelectedIndex="0" SelectionChanged="OnOptionsChanged"
                              AutomationProperties.Name="{DynamicResource RestorationMode}">
                        <ComboBoxItem Content="{DynamicResource RestorationAutomatic}"/>
                        <ComboBoxItem Content="{DynamicResource RestorationFocus}"/>
                        <ComboBoxItem Content="{DynamicResource RestorationMotion}"/>
                        <ComboBoxItem Content="{DynamicResource RestorationNoise}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{DynamicResource RestorationStrength}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="StrengthBox" Width="146" MinHeight="32" SelectedIndex="1" SelectionChanged="OnOptionsChanged"
                              AutomationProperties.Name="{DynamicResource RestorationStrength}">
                        <ComboBoxItem Content="{DynamicResource RestorationGentle}"/>
                        <ComboBoxItem Content="{DynamicResource RestorationBalanced}"/>
                        <ComboBoxItem Content="{DynamicResource RestorationStrong}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{DynamicResource ScaleHeading}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ScaleBox" Width="125" MinHeight="32" SelectedIndex="0" SelectionChanged="OnOptionsChanged"
                              AutomationProperties.Name="{DynamicResource ScaleHeading}">
                        <ComboBoxItem Content="{DynamicResource RestorationOriginalSize}"/>
                        <ComboBoxItem Content="2×"/>
                    </ComboBox>
                </StackPanel>
              </WrapPanel>
            </Expander>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="4" Margin="0,6,0,0"
                         Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="{DynamicResource RestoringPhoto}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,11,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource CancelProcessing}" Visibility="Collapsed" Click="OnCancel"
                    Style="{StaticResource StudioButton}" Margin="0,0,8,0"/>
            <Button x:Name="PreviewButton" Content="{DynamicResource RestorationStart}" Click="OnPreview"
                    Style="{StaticResource StudioButton}" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="DrawButton" Content="{DynamicResource DrawDetails}" Click="OnDrawDetails"
                    ToolTip="{DynamicResource DrawDetailsTip}" Style="{StaticResource StudioButton}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource StudioButton}" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="{DynamicResource RestorationSave}" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="OnSave"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="14">
            <p:ComparisonView x:Name="ComparisonPanel"/>
        </Border>
    </DockPanel>
</Window>
