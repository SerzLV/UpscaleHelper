<Window x:Class="UpscaleHelper.Presentation.PhotoRestorationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="{DynamicResource RestorePhoto}" Width="1140" Height="790" MinWidth="680" MinHeight="550"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Window.Resources>
        <Geometry x:Key="Sparkle">M10,1 L12.3,7.7 19,10 12.3,12.3 10,19 7.7,12.3 1,10 7.7,7.7 Z</Geometry>
        <Style x:Key="MethodCard" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceRow}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="58"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,16,20,10">
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="#302653"
                        BorderBrush="#564580" BorderThickness="1" Margin="0,0,11,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource Sparkle}" Fill="{StaticResource AccentBrush}" Width="19" Height="19"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource RestorePhoto}" Style="{StaticResource DialogHeading}"/>
                    <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="MethodChoice" Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource MethodCard}"
                     SelectedIndex="0" SelectionChanged="OnMethodChanged" AutomationProperties.Name="{DynamicResource RestorationMode}">
                <ListBoxItem AutomationProperties.Name="{DynamicResource RestorationNatural}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RestorationNatural}"/>
                        <TextBlock Text="{DynamicResource RestorationNaturalHint}" Style="{StaticResource MutedText}" FontWeight="Normal"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Margin="3,0,0,0" AutomationProperties.Name="{DynamicResource DrawDetails}"
                             AutomationProperties.HelpText="{DynamicResource DrawDetailsTip}" ToolTip="{DynamicResource DrawDetailsTip}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="#3C3055"
                                    CornerRadius="5" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource RestorationExperimental}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{DynamicResource DrawDetails}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource RestorationDrawHint}" Style="{StaticResource MutedText}" FontWeight="Normal"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12" Padding="13">
            <p:ComparisonView ShowOriginalFullWidth="True" PreferWipe="True"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <StackPanel>
                <DockPanel Margin="0,0,0,9">
                    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" VerticalAlignment="Top" Margin="0,6,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=SaveButton}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource MintBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </DockPanel>
                <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="4" Margin="0,0,0,9"
                             Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="{DynamicResource RestoringPhoto}"/>
                <CheckBox x:Name="KeepAppearance" Content="{DynamicResource FluxKeepAppearance}" IsChecked="True"
                          Visibility="Collapsed" Margin="0,0,0,10" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged"
                          Foreground="{StaticResource TextBrush}" ToolTip="{DynamicResource FluxKeepAppearanceTip}"/>
                <Grid>
                    <Expander x:Name="AdvancedOptions" Style="{StaticResource CanvasExpander}" Header="{DynamicResource RestorationAdvanced}"
                              Foreground="{StaticResource TextBrush}" Margin="0,2,0,0">
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel x:Name="CorrectionOption" Width="185" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource RestorationCorrection}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ModeBox" MinHeight="32" SelectedIndex="0" SelectionChanged="OnOptionsChanged"
                                          AutomationProperties.Name="{DynamicResource RestorationCorrection}">
                                    <ComboBoxItem Content="{DynamicResource RestorationAutomatic}"/>
                                    <ComboBoxItem Content="{DynamicResource RestorationFocus}"/>
                                    <ComboBoxItem Content="{DynamicResource RestorationMotion}"/>
                                    <ComboBoxItem Content="{DynamicResource RestorationNoise}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="StrengthOption" Width="146" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource RestorationStrength}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="StrengthBox" MinHeight="32" SelectedIndex="1" SelectionChanged="OnOptionsChanged"
                                          AutomationProperties.Name="{DynamicResource RestorationStrength}">
                                    <ComboBoxItem Content="{DynamicResource RestorationGentle}"/>
                                    <ComboBoxItem Content="{DynamicResource RestorationBalanced}"/>
                                    <ComboBoxItem Content="{DynamicResource RestorationStrong}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="162">
                                <TextBlock Text="{DynamicResource RestorationOutputSize}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ScaleBox" MinHeight="32" SelectedIndex="0" SelectionChanged="OnOptionsChanged"
                                          AutomationProperties.Name="{DynamicResource RestorationOutputSize}">
                                    <ComboBoxItem Content="{DynamicResource RestorationOriginalSize}"/>
                                    <ComboBoxItem Content="2×"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </Expander>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton" Content="{DynamicResource CancelProcessing}" Visibility="Collapsed" Click="OnCancel"
                                Style="{StaticResource DialogButton}"/>
                        <Button x:Name="PreviewButton" Content="{DynamicResource RestorationStart}" Click="OnPreview"
                                Style="{StaticResource DialogPrimary}" IsDefault="True"/>
                        <Button x:Name="SaveButton" Content="{DynamicResource RestorationSave}" Style="{StaticResource DialogPrimary}"
                                IsEnabled="False" Visibility="Collapsed" Click="OnSave"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
