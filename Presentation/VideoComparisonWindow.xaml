<Window x:Class="UpscaleHelper.Presentation.VideoComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:UpscaleHelper.Presentation"
        Title="{DynamicResource VideoComparison}" Width="1140" Height="670" MinWidth="700" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        Language="{DynamicResource UiLanguage}" FontFamily="Segoe UI" FontSize="13" Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed"
        PreviewKeyDown="OnFrameKey">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,16,20,12">
            <TextBlock Text="{DynamicResource VideoComparison}" Style="{StaticResource DialogHeading}"/>
            <TextBlock x:Name="FileLabel" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock x:Name="ExportEstimate" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,4,0,0"
                       ToolTip="{DynamicResource ExportEstimateTip}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9" Margin="20,0,20,12">
            <DockPanel>
                <UniformGrid x:Name="PlaybackLabels" Columns="2" DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource OriginalTag}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ResultTag}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                </UniformGrid>
                <Grid Background="#0C0E16">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                  IsMuted="True" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                    <TextBlock x:Name="PlaybackMessage" Text="{DynamicResource Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="16" Style="{StaticResource MutedText}"/>
                    <Grid x:Name="FrameLayer" Visibility="Collapsed" Background="#0C0E16">
                        <p:ComparisonView x:Name="FrameComparison" Margin="6"/>
                        <Border x:Name="FrameStatus" Background="#EF12141C" CornerRadius="8" Padding="12,8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="FrameMessage" TextWrapping="Wrap" MaxWidth="440" Style="{StaticResource MutedText}"/>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="PositionLabel" DockPanel.Dock="Right" Width="110" TextAlignment="Right"
                               Style="{StaticResource MutedText}" FontFamily="Consolas" VerticalAlignment="Center"
                               ToolTip="{DynamicResource PreviewTimeTip}"/>
                    <Slider x:Name="Timeline" Margin="0,0,8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                            IsEnabled="False" ValueChanged="OnSeek" AutomationProperties.Name="{DynamicResource FrameTimeline}"/>
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="PlayButton" Style="{StaticResource DialogPrimary}" Content="{DynamicResource Pause}"
                                Width="108" IsEnabled="False" Click="OnTogglePlay" Margin="0,0,8,0"/>
                        <Button x:Name="PreviousFrame" Style="{StaticResource DialogButton}" Content="{DynamicResource PreviousButton}" Click="OnPreviousFrame"
                                IsEnabled="False" Padding="9,6" AutomationProperties.Name="{DynamicResource PreviousFrame}" ToolTip="{DynamicResource PreviousFrameTip}"/>
                        <Button x:Name="NextFrame" Style="{StaticResource DialogButton}" Content="{DynamicResource NextButton}" Click="OnNextFrame"
                                IsEnabled="False" Padding="9,6" Margin="5,0,0,0"
                                AutomationProperties.Name="{DynamicResource NextFrame}" ToolTip="{DynamicResource NextFrameTip}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="9,0,0,0">
                        <Button x:Name="SoundButton" Style="{StaticResource DialogButton}" Content="{DynamicResource Unmute}"
                                Width="133" IsEnabled="False" Click="OnToggleSound" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource DialogButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="FrameLabel" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
